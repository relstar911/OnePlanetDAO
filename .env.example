# =============================================================================
# OnePlanet DAO — Environment Configuration
# Copy this file to .env and fill in your values.
# =============================================================================

# --- JWT Authentication ---
# REQUIRED in production. Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
ONEPLANET_JWT_SECRET=change-me-to-a-random-secret
ONEPLANET_JWT_ALGORITHM=HS256
ONEPLANET_JWT_EXPIRE_MINUTES=60

# --- Database ---
# SQLite (default for development):
DATABASE_URL=sqlite:///./oneplanet.db
# PostgreSQL (recommended for production):
# DATABASE_URL=postgresql://user:password@localhost:5432/oneplanet

# --- CORS ---
# Comma-separated list of allowed origins for production.
# In development mode, localhost:3000 and localhost:5173 are always allowed.
ALLOWED_ORIGINS=https://your-frontend-domain.com

# --- Rate Limiting ---
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_STRICT=10/minute

# --- Environment ---
# Options: development, production
ENVIRONMENT=development

# --- Testing ---
# Set to 1 when running tests
# TESTING=1

# --- Logging ---
LOG_LEVEL=INFO
