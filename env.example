# OnePlanet Backend Configuration
# Copy this file to .env and fill in your values

# JWT Authentication
ONEPLANET_JWT_SECRET=change-me-to-a-long-random-secret-key
ONEPLANET_JWT_ALGORITHM=HS256
ONEPLANET_JWT_EXPIRE_MINUTES=60

# Database (PostgreSQL for production, SQLite for development)
# SQLite:   sqlite:///./oneplanet.db
# Postgres: postgresql://user:password@localhost:5432/oneplanet
DATABASE_URL=sqlite:///./oneplanet.db

# Rate Limiting
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_STRICT=10/minute

# Environment
ENVIRONMENT=development
TESTING=0

# Logging
LOG_LEVEL=INFO
